# Allowlist: application build inputs only. No secrets, tests, datasets or papers.
**
!Dockerfile
!.dockerignore
!pom.xml
!mvnw
!lombok.config
!.mvn/
!.mvn/wrapper/
!.mvn/wrapper/maven-wrapper.properties
!src/
!src/main/
!src/main/**
!deploy/
!deploy/backend/
!deploy/backend/**
# Defence in depth for future allowlist edits.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/datasets/**
**/experiments/**
**/*.tex
**/node_modules/**
