# Copy to .env, chmod 600; supply fresh secrets externally. Do not print `compose config`.
# Use release manifest image@sha256 references for production. Local build tags work for smoke only.
BACKEND_IMAGE=ghcr.io/koshikovme/socratesai/backend:SET_RELEASE_TAG
FRONTEND_IMAGE=ghcr.io/koshikovme/socratesai/frontend:SET_RELEASE_TAG
POLICY_IMAGE=ghcr.io/koshikovme/socratesai/policy-api:SET_RELEASE_TAG
APP_DOMAIN=practice.example.org
APP_PUBLIC_ORIGIN=https://practice.example.org
EDGE_BIND_ADDRESS=0.0.0.0
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
# Absolute external directory: fullchain.pem + privkey.pem, readable by edge UID/GID 101.
TLS_DIRECTORY=
POSTGRES_DB=socratesdb
POSTGRES_USER=socrates
# Mandatory: unique >=16 characters, no usable default. Example generation: openssl rand -hex 32
POSTGRES_PASSWORD=
# Separate operator role; the backend uses only the non-superuser application role above.
POSTGRES_ADMIN_USER=cluster_admin
POSTGRES_ADMIN_PASSWORD=
# Mandatory: random >=64 decoded bytes. Example generation: openssl rand -base64 64 | tr -d '\n'
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MS=3600000
APP_POLICY_MODE=ml
APP_POLICY_ML_ENABLED=true
APP_POLICY_ML_MIN_CONFIDENCE=0.35
# Baked model paths/checksums and private ML URL are fixed in Compose.
APP_GEMINI_ENABLED=false
GEMINI_API_KEY=
APP_GEMINI_MODEL=
APP_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
APP_OPENAI_ENABLED=false
OPENAI_API_KEY=
APP_OPENAI_MODEL=
APP_OPENAI_BASE_URL=https://api.openai.com/v1
# Enable only for controlled first-admin provisioning, then disable/unset its credentials.
APP_ADMIN_BOOTSTRAP_ENABLED=false
APP_ADMIN_BOOTSTRAP_EMAIL=
APP_ADMIN_BOOTSTRAP_PASSWORD=
APP_ADMIN_BOOTSTRAP_FULL_NAME=
# No Judge0 host has been certified. Both flags stay false until it exists.
APP_JUDGE0_ENABLED=false
APP_JUDGING_ENABLED=false
APP_JUDGE0_BASE_URL=
APP_JUDGE0_API_KEY=
APP_JUDGE0_AUTH_HEADER=X-Auth-Token
APP_JUDGE0_ALLOW_PLAIN_HTTP=false
# Nonsecret operator-verified runtime bindings, read-only; empty example works only with Judge0 disabled.
APP_RUNTIME_CONFIG_FILE=./deploy/runtime-catalog.yaml.example
APP_JUDGE0_CONNECT_TIMEOUT=2s
APP_JUDGE0_REQUEST_TIMEOUT=5s
APP_JUDGE0_OPERATION_TIMEOUT=30s
APP_JUDGE0_INITIAL_BACKOFF=100ms
APP_JUDGE0_MAX_BACKOFF=2s
APP_JUDGE0_CATALOG_TTL=1m
APP_JUDGE0_MAX_BATCH_SIZE=5
APP_JUDGE0_MAX_CONCURRENT_OPERATIONS=16
APP_JUDGE0_MAX_RESPONSE_BYTES=2097152
APP_JUDGE0_MAX_SOURCE_BYTES=80000
APP_JUDGE0_MAX_TEST_BYTES=65536
APP_JUDGE0_MAX_PROCESSES=64
APP_JUDGE0_MAX_POLL_ATTEMPTS=100
APP_JUDGING_CONCURRENCY=4
APP_JUDGING_BATCH_SIZE=5
APP_JUDGING_MAX_ATTEMPTS=3
APP_JUDGING_MAX_PER_USER=5
APP_JUDGING_MAX_QUEUED=1000
APP_JUDGING_LEASE=15s
APP_JUDGING_DEADLINE=5m
APP_JUDGING_SAMPLE_TTL=15m
APP_JUDGING_INITIAL_BACKOFF=1s
APP_JUDGING_MAX_BACKOFF=10s
APP_REFERENCE_VERIFICATION_TIMEOUT=30s
APP_REFERENCE_VERIFICATION_EVIDENCE_TTL=30m
APP_REFERENCE_VERIFICATION_MAX_CONCURRENT=4
APP_REFERENCE_VERIFICATION_BATCH_SIZE=5
APP_MENTOR_DEBOUNCE_MS=250
APP_MENTOR_MIN_INTERVAL_MS=1000
APP_MENTOR_TIMEOUT_MS=15000
APP_MENTOR_CONCURRENCY=4
APP_MENTOR_MESSAGES_PER_SECOND=20
APP_MENTOR_SESSIONS_PER_USER=4
APP_MENTOR_EDITORS_PER_USER=4
APP_MENTOR_MAX_SESSIONS=1024
APP_MENTOR_MAX_EDITORS=1024
