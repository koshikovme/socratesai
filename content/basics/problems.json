      "key": "sum-two",
      "title": "Сумма двух чисел",
      "topic": "Арифметика",
      "statement": "Вычислите сумму двух целых чисел. Функция получает оба числа как отдельные параметры. Верните их сумму.",
      "inputFormat": "Два целых числа firstNumber и secondNumber через пробел.",
      "outputFormat": "Одно целое число — сумма.",
      "constraintsText": "−1000 ≤ firstNumber, secondNumber ≤ 1000.",
      "contract": {
        "functionName": "add",
        "returnType": "INTEGER",
        "parameters": [
          {
            "name": "firstNumber",
            "type": "INTEGER"
          },
          {
            "name": "secondNumber",
            "type": "INTEGER"
          }
        ]
      },
      "samples": [
        {
          "inputData": "2 3\n",
          "expectedOutput": "5\n"
        },
        {
          "inputData": "-4 7\n",
          "expectedOutput": "3\n"
        }
      ]
    },
